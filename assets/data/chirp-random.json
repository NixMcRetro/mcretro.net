---
layout: null
permalink: /assets/data/chirp-random.json
---
{% assign chirp_posts = site.categories.parrots | where_exp: "bird", "bird.channel_chirp != false" %}
[
{% for bird in chirp_posts %}
  {% assign day = bird.date | date: '%-d' | plus: 0 %}
  {% case day %}
    {% when 1 or 21 or 31 %}{% assign ordinal = 'st' %}
    {% when 2 or 22 %}{% assign ordinal = 'nd' %}
    {% when 3 or 23 %}{% assign ordinal = 'rd' %}
    {% else %}{% assign ordinal = 'th' %}
  {% endcase %}
  {"url": {{ bird.url | relative_url | jsonify }}, "title": {{ bird.title | jsonify }}, "date": {{ bird.date | date: '%Y-%m-%d' | jsonify }}, "date_label": {{ day | append: ordinal | append: ' ' | append: (bird.date | date: '%B %Y') | jsonify }} }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
